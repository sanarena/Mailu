# Mailu IMAP/SMTP (mail lane)
MAILU_IMAP_HOST=localhost
MAILU_IMAP_PORT=993
MAILU_IMAP_USER=you@example.com
MAILU_IMAP_PASSWORD=secret
MAILU_IMAP_SSL=true
MAILU_SMTP_HOST=localhost
MAILU_SMTP_PORT=587
MAILU_SMTP_USER=you@example.com
MAILU_SMTP_PASSWORD=secret
MAILU_SMTP_STARTTLS=true
MAILU_DEFAULT_FROM=you@example.com

# Mailu admin REST API (admin lane)
MAILU_API_BASE=https://localhost/api
MAILU_API_TOKEN=changeme
MAILU_API_TIMEOUT=30

# Gmail source (gmail-import lane)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# ... or provide a ready access token instead:
GMAIL_ACCESS_TOKEN=
