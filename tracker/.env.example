# Public hostname serving the pixel, click redirector and dashboard.
TRACK_HOST=track.arminnikdel.com
# Listener ports inside the container.
MILTER_PORT=8899
WEB_PORT=8080
# SQLite database (persistent volume in k8s).
DB_PATH=/data/tracker.db
# GeoIP database baked into the image (override to mount a fresher one).
GEO_DB_PATH=/app/geo/location.dat
# Mailbox servers for dashboard login and panel compose.
IMAP_HOST=imap.arminnikdel.com
IMAP_PORT=993
SMTP_HOST=imap.arminnikdel.com
SMTP_PORT=465
# Sender domains eligible for tracking (comma separated).
LOCAL_DOMAINS=arminnikdel.com
# Dashboard admins (comma separated, see everything).
TRACKER_ADMINS=admin@arminnikdel.com
# REQUIRED secrets (generate with: python3 -c 'import secrets;print(secrets.token_hex(32))').
# Never commit real values; in k8s they live in the live-only tracker-secrets Secret.
SESSION_SECRET=change-me-64-hex-chars
HMAC_SECRET=change-me-64-hex-chars
# Safety ramp: true = parse and log, never modify mail or write rows.
DRY_RUN=false
# Guard rails.
MAX_MIME_BYTES=10485760
MAX_RECIPIENTS=200
MAX_LINKS=500
RETENTION_DAYS=365
SESSION_HOURS=12
